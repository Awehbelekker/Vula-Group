# ═══════════════════════════════════════════════════════════════════════════
# Vula Group — Railway Environment Variables
# Copy each line into Railway: Dashboard → Project → Variables → Add
# ═══════════════════════════════════════════════════════════════════════════

# ── AI — Qdrant Cloud ────────────────────────────────────────────────────────
# 1. Go to cloud.qdrant.io → Create free cluster (1GB)
# 2. Copy the cluster URL and API key
QDRANT_BASE=https://YOUR-CLUSTER-ID.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# ── AI — LLM (OpenRouter for cloud inference) ────────────────────────────────
# Railway has no GPU — LLM calls go via OpenRouter (free tier available)
# 1. Go to openrouter.ai → Create account → API Keys → Create key
# 2. Railway will use kimi-k2 by default (cheap, fast)
OPENROUTER_API_KEY=your-openrouter-api-key
# Point Ollama base to OpenRouter-compatible endpoint
OLLAMA_BASE=https://openrouter.ai/api/v1
MODEL_WORKER=openai/deepseek/deepseek-r1-distill-llama-70b
MODEL_EMBED=openai/text-embedding-3-small

# ── Supabase ─────────────────────────────────────────────────────────────────
# 1. Go to supabase.com → New project (free tier)
# 2. Run db/migrations/001_vula_initial.sql in the SQL editor
# 3. Project Settings → API → copy these two values
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── WhatsApp Business API ────────────────────────────────────────────────────
# From Meta Business Manager after registering +27673636081
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER=27673636081
WHATSAPP_PHONE_ID=your-phone-number-id
WHATSAPP_TOKEN=your-permanent-access-token
WHATSAPP_VERIFY_TOKEN=vula-webhook-2026
TEAM_WHATSAPP=27827077080

# ── API Security ─────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=generate-a-strong-random-key-here

# ── App URL (your Railway domain) ────────────────────────────────────────────
# Railway gives you: https://YOUR-APP-NAME.up.railway.app
VULA_BASE_URL=https://your-app-name.up.railway.app

# ── PayFast (add when billing is ready) ──────────────────────────────────────
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=

# ── Email notifications (Resend — free 3000/month) ───────────────────────────
# resend.com → Create account → API Keys
RESEND_API_KEY=
FROM_EMAIL=Vula <hello@vula.ai>
TEAM_EMAIL=judy@digg.co.za

# ── These are set automatically by Railway — do not change ───────────────────
# PORT is injected by Railway at runtime
# DATA_DIR=/data is set in the Dockerfile

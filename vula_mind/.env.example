# ── Copy this file to .env and fill in your values ──────────────────────────
# cp .env.example .env

# ── Ollama (local inference) ─────────────────────────────────────────────────
OLLAMA_BASE=http://localhost:11434
MODEL_EDGE=llama3.1:8b
MODEL_WORKER=deepseek-r1:8b
MODEL_REASONER=deepseek-r1:14b
MODEL_EMBED=bge-m3
MODEL_OCR=llava:7b

# ── Qdrant (vector store) ────────────────────────────────────────────────────
QDRANT_BASE=http://localhost:6333
QDRANT_API_KEY=

# ── API Server ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=7438

# REQUIRED in production — set a strong random key
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DEBUG=false

# ── Hardware ─────────────────────────────────────────────────────────────────
MESH_ROLE=desktop
VRAM_TOTAL_GB=24.0

# ── Onboarding — Supabase ────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
# Same value as SUPABASE_SERVICE_KEY — kept under both names because the
# commerce service reads SUPABASE_SERVICE_ROLE_KEY directly.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Onboarding — WhatsApp Business API ──────────────────────────────────────
# Meta Business > WhatsApp > API Setup > Phone Number ID + Permanent Token
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_ID=your-phone-number-id
# Used by the commerce service for outbound order-status messages.
# Usually the same value as WHATSAPP_PHONE_ID.
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_TOKEN=your-permanent-access-token
TEAM_WHATSAPP=+27820000000     # Richard/Judy's number — gets new signup alerts
# Generate: python -c "import secrets; print(secrets.token_hex(16))"
WHATSAPP_VERIFY_TOKEN=          # Meta webhook verification token

# ── Onboarding — PayFast ─────────────────────────────────────────────────────
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=

# ── Yoco (Vula Commerce payments) ────────────────────────────────────────────
# yoco.com > Developers > API keys
YOCO_SECRET_KEY=
YOCO_PUBLIC_KEY=
YOCO_WEBHOOK_SECRET=

# ── Vula Commerce — per-tenant storefront URLs (JSON) ───────────────────────
# Used for Yoco redirect URLs after successful payment.
STORE_URLS_JSON={"off-the-hook": "https://offthehook.co.za", "awake-sa": "https://awakesa.co.za"}

# ── n8n workflow automation webhook base ────────────────────────────────────
# e.g. https://n8n.vula.co.za/webhook  — leave blank to disable.
N8N_WEBHOOK_BASE=

# ── Cloud LLM fallback (OpenRouter) ──────────────────────────────────────────
# Required on Railway (no local Ollama). Optional on a workstation with Ollama.
# Generate at: openrouter.ai > Keys
OPENROUTER_API_KEY=

# ── Onboarding — Email (Resend) ───────────────────────────────────────────────
# Sign up free at resend.com → API Keys → create key → paste below
# Add and verify your domain at resend.com → Domains → add vula.ai
RESEND_API_KEY=
FROM_EMAIL=Vula Group <hello@vula.ai>
TEAM_EMAIL=team@vula.ai          # receives new signup alert emails

# ── Onboarding — App URL ─────────────────────────────────────────────────────
VULA_BASE_URL=https://app.vula.ai

# ── Dashboard env vars (create vula_dashboard/.env.local) ───────────────────
# VITE_API_URL=https://app.vula.ai
# VITE_TEAM_WHATSAPP=+27820000000

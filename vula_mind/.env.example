# ── Copy this file to .env and fill in your values ──────────────────────────
# cp .env.example .env

# ── Ollama (local inference) ─────────────────────────────────────────────────
OLLAMA_BASE=http://localhost:11434
MODEL_WORKER=deepseek-r1:7b
MODEL_REASONER=deepseek-r1:14b
MODEL_EDGE=deepseek-r1:1.5b
MODEL_EMBED=bge-m3
MODEL_OCR=glm-ocr

# ── Qdrant (vector store) ────────────────────────────────────────────────────
QDRANT_BASE=http://localhost:6333
QDRANT_API_KEY=

# ── API Server ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=7438

# REQUIRED in production — set a strong random key
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DEBUG=false

# ── Hardware ─────────────────────────────────────────────────────────────────
MESH_ROLE=desktop
VRAM_TOTAL_GB=24.0

# ── Onboarding — Supabase ────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── Onboarding — WhatsApp Business API ──────────────────────────────────────
# Meta Business > WhatsApp > API Setup > Phone Number ID + Permanent Token
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_ID=your-phone-number-id
WHATSAPP_TOKEN=your-permanent-access-token
TEAM_WHATSAPP=+27820000000     # Richard/Judy's number — gets new signup alerts

# ── Onboarding — PayFast ─────────────────────────────────────────────────────
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=

# ── Onboarding — App URL ─────────────────────────────────────────────────────
VULA_BASE_URL=https://app.vula.ai

# ── Dashboard env vars (create vula_dashboard/.env.local) ───────────────────
# VITE_TEAM_WHATSAPP=+27820000000

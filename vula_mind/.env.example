# ── Copy this file to .env and fill in your values ──────────────────────────
# cp .env.example .env

# ── Ollama (local inference) ─────────────────────────────────────────────────
OLLAMA_BASE=http://localhost:11434
MODEL_WORKER=deepseek-r1:7b
MODEL_REASONER=deepseek-r1:14b
MODEL_EDGE=deepseek-r1:1.5b
MODEL_EMBED=bge-m3
MODEL_OCR=glm-ocr

# ── Qdrant (vector store) ────────────────────────────────────────────────────
QDRANT_BASE=http://localhost:6333
QDRANT_API_KEY=

# ── API Server ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=7438

# REQUIRED in production — set a strong random key
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DEBUG=false

# ── Hardware ─────────────────────────────────────────────────────────────────
MESH_ROLE=desktop
VRAM_TOTAL_GB=24.0

{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {
    "below_error": {
      "()": "vula.log_streams.BelowError"
    }
  },
  "formatters": {
    "json": {
      "()": "vula.log_streams.JsonFormatter"
    }
  },
  "handlers": {
    "out": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "formatter": "json",
      "filters": [
        "below_error"
      ]
    },
    "err": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stderr",
      "formatter": "json",
      "level": "ERROR"
    },
    "access": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "formatter": "json"
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": [
        "out",
        "err"
      ],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "level": "INFO"
    },
    "uvicorn.access": {
      "handlers": [
        "access"
      ],
      "level": "INFO",
      "propagate": false
    }
  }
}

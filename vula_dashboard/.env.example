# ── Vula Admin Dashboard (Vite) ─────────────────────────────────────────────
# Copy to .env.local for development:  cp .env.example .env.local
# All VITE_* vars are inlined into the client bundle — never put secrets here.

# Backend API base URL. In dev, leaving this unset falls back to /api which is
# served by Vite's proxy or the same origin in prod.
VITE_API_URL=http://localhost:7438

# (VITE_API_KEY removed — the dashboard authenticates with the signed-in user's
# session JWT via lib/authFetch.js. Never put the server API key in a VITE_ var:
# it ships inside the browser bundle.)

# Team WhatsApp number shown on the onboarding "questions?" prompt
VITE_TEAM_WHATSAPP=+27820000000

# ── WhatsApp Embedded Signup (Meta) ─────────────────────────────────────────
# Powers the "Connect WhatsApp" button in Vula Admin. Clients self-connect
# their WhatsApp Business account in 2 minutes via Meta's hosted flow.
#
# Setup: developers.facebook.com → create "Vula Commerce" app →
#        Add WhatsApp product → enable Embedded Signup → create a configuration
VITE_FB_APP_ID=
VITE_FB_CONFIG_ID=

# ── Supabase (Auth + Storage for product images) ─────────────────────────────
# Get from Supabase Dashboard → Settings → API
# ANON key is safe to expose in the browser bundle — RLS policies protect data
VITE_SUPABASE_URL=https://jzccetzmahpcoiqwlljm.supabase.co
VITE_SUPABASE_ANON_KEY=
